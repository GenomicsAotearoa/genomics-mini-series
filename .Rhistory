# Step 1: put both gene lists into a named list
gene_lists <- list(
Upregulated   = genes_MT_UP,
Downregulated = genes_MT_DOWN
)
# Step 2: run compareCluster
# The fun argument specifies which enrichment function to use — we use
# enricher() because we have custom annotations (same as before)
cc_result <- compareCluster(
geneCluster   = gene_lists,
fun           = enricher,
universe      = background,
TERM2GENE     = term2gene,
pvalueCutoff  = 0.05,
pAdjustMethod = "BH"
)
