#| message: false
library(DESeq2)
# >> DGE-related variables ----
COUNTS_FILE = "data-files/readspergene_v2.matrix"
COLDATA_FILE = "data-files/coldata_v2.3.2.txt"
# Specify significance threshold
SIGNIFICANCE_CUTOFF = 0.001
# >> Counts file ----
counts.table = read.table(file=COUNTS_FILE, header = TRUE, sep = "\t", stringsAsFactors = FALSE, row.names = "GeneID")
# >> Coldata file ----
coldata.table = read.table(file=COLDATA_FILE, header = TRUE, sep = "\t", stringsAsFactors = FALSE, row.names = "sample")
#factorise
coldata.table$histov22 <- factor(coldata.table$histov22, levels=c("F","ET","MT","LT","TPM","IPM"))
# Create a DESeq2 object for pairwise comparisons
dds <- DESeqDataSetFromMatrix(countData = counts.table, colData = coldata.table, design = ~ histov22 )
dds <- estimateSizeFactors(dds)
# Drop low count genes
nc <- counts(dds, normalized=TRUE)
filter <- rowSums(nc >= 10) >= 2
dds <- dds[filter,]
# Run DESeq2
dds <- DESeq(dds)
# Run DESeq2
dds <- DESeq(dds)
res <- results(dds, alpha=SIGNIFICANCE_CUTOFF)
res <- res[order(res$padj),]
res <- na.omit(res)
# Extract pairwise comparison results
comparisons = c("histov22_MT_vs_F")
# Initialise lists
store results
# Extract pairwise comparison results
comparisons = c("histov22_MT_vs_F", "histov22_TPM_vs_F")
# Initialise lists to store results
results_list <- list()
de_results_list <- list()
for (c in comparisons)
{
# Extract relevant details from comparison
cSplit <- strsplit(c, "_")
contrast <- cSplit[[1]][1]
group1 <- cSplit[[1]][2]
group2 <- cSplit[[1]][4]
# Obtain pairwise comparison of interest
res.pw <- results(dds, alpha = SIGNIFICANCE_CUTOFF, contrast = c(contrast, group1, group2))
# Clean up
res.pw <- res.pw[order(res.pw$padj), ]
res.pw <- na.omit(res.pw)
# Convert to data frame and store full results
results_list[[c]] <- as.data.frame(res.pw)
# Get DE genes and store
de_results_list[[c]] <- as.data.frame(res.pw[res.pw$padj < SIGNIFICANCE_CUTOFF, ])
}
df_TPM <- de_results_list[["histov22_TPM_vs_F"]]
dfTPM_UP <- df_TPM[df_TPM$log2FoldChange > 0 ,]
dfTPM_DOWN <- df_TPM[df_TPM$log2FoldChange < 0 ,]
nrow(dfTPM_UP) + nrow(dfTPM_DOWN) == nrow(df_TPM)
genes_TPM_UP <- rownames(dfTPM_UP)
genes_TPM_DOWN <- rownames(dfTPM_DOWN)
#| message: false
DE.vector <- background  %in%  genes_TPM_UP
sum(DE.vector) == length(genes_TPM_UP) ## test - should be TRUE
DE.vector <-  DE.vector * 1
names(DE.vector) <-  background
sum(DE.vector) == length(genes_TPM_UP) ## test again- should still be TRUE
length(DE.vector) == length(length.vector) ## test - should be TRUE
data.pwf <- nullp(DEgenes=DE.vector, bias.data=length.vector)
go_output <- goseq(data.pwf, gene2cat = splitgoannot)
go_output.SIG.TPM_UP <-  go_output[go_output$over_represented_pvalue <= GOSEQ_SIGNIFICANCE_THRESHOLD | go_output$under_represented_pvalue <= GOSEQ_SIGNIFICANCE_THRESHOLD,]
go_output.SIG.TPM_UP <- go_output.SIG.TPM_UP %>%
mutate(GeneRatio = numDEInCat / numInCat)
goout_TPM_UP_over  <- go_output.SIG.TPM_UP[go_output.SIG.TPM_UP$over_represented_pvalue  < GOSEQ_SIGNIFICANCE_THRESHOLD, ]
goout_TPM_UP_under <- go_output.SIG.TPM_UP[go_output.SIG.TPM_UP$under_represented_pvalue < GOSEQ_SIGNIFICANCE_THRESHOLD, ]
nrow(goout_TPM_UP_over) + nrow(goout_TPM_UP_under) == nrow(go_output.SIG.TPM_UP)
# Step 1: put both gene lists into a named list
gene_lists <- list(
UpregulatedMT   = genes_MT_UP,
UpregulatedTPM = genes_TPM_UP
)
# Step 2: run compareCluster
# The fun argument specifies which enrichment function to use — we use
# enricher() because we have custom annotations (same as before)
cc_result <- compareCluster(
geneCluster   = gene_lists,
fun           = enricher,
universe      = background,
TERM2GENE     = term2gene,
pvalueCutoff  = 0.05,
pAdjustMethod = "BH"
)
# Step 3: plot — dotplot is the default and works best for compareCluster
dotplot(cc_result, showCategory = 15) +
labs(title = "Enriched GO terms — MT vs F, upregulated and downregulated genes") +
theme(axis.text.y = element_text(size = 8),
axis.text.x = element_text(angle = 45, hjust = 1))
set.seed(42)
# A handful of fake but plausible-looking KEGG pathway IDs
fake_kegg_pathways <- c(
"ko00010", "ko00020", "ko00030", "ko00040", "ko00051",
"ko00052", "ko00061", "ko00071", "ko00100", "ko00120",
"ko00130", "ko00140", "ko00190", "ko00220", "ko00230",
"ko00240", "ko00250", "ko00260", "ko00270", "ko00280"
)
# Assign 0-3 random KEGG pathways to each gene in background
# (most genes get none, mimicking real sparsity of KEGG annotation)
fake_kegg <- data.frame(
GeneID = background,
KEGGs  = sapply(background, function(g) {
n <- sample(0:3, 1, prob = c(0.5, 0.3, 0.15, 0.05))  # most genes unannotated
if (n == 0) return(".")
paste(sample(fake_kegg_pathways, n), collapse = ",")
})
)
head(fake_kegg)
View(fake_kegg)
# Reformat into the splitgoannot structure goseq expects
fake_kegg[fake_kegg == "."] <- NA
splitkeggannot <- strsplit(fake_kegg[, 2], split = ",")
names(splitkeggannot) <- as.vector(fake_kegg[, 1])
View(splitkeggannot)
# Run goseq — identical to GO pipeline
kegg_pwf <- nullp(DEgenes = DE.vector, bias.data = length.vector)
kegg_output <- goseq(kegg_pwf, gene2cat = splitkeggannot)
head(kegg_output)
View(kegg_output)
rm(fake_kegg)
rm(fak)
rm(fake_kegg_pathways
)
rm(kegg_output)
rm(kegg_pwf)
rm(splitkeggannot)
ko.pathways <- download_KEGG(species = "ko")
View(ko.pathways)
kegg_names  <- ko.pathways$KEGGPATHID2NAME  # ready-made ID → name table
